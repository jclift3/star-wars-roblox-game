# Roblox Studio specific files
*.rbxl
*.rbxlx
*.rbxm
*.rbxmx

# ...except the models under assets/, which are source, not build output.
#
# Rojo does NOT mount this directory -- it cannot. `MeshPart.MeshId` is one
# of the few properties Roblox will not let a plugin write, so live sync
# builds the parts, fails once per mesh ("26 changes failed to apply",
# 2026-08-30) and leaves a blaster made of blank cubes. The file is inserted
# into the place by hand, once, and lives in the place file after that --
# the same deal as the template world's scenery.
#
# Tracked anyway, because it is the only copy of geometry one of the boys
# modelled and losing it means it never existed. A narrow exception rather
# than dropping the rules above, which are still right for everything
# Studio exports by accident.
!assets/**/*.rbxm
!assets/**/*.rbxmx

# Roblox Studio cache and temporary files
*.rbxl.lock
*.rbxlx.lock
*.rbxm.lock
*.rbxmx.lock

# Windows specific
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS specific
.DS_Store
.AppleDouble
.LSOverride

# Linux specific
*~
.fuse_hidden*
.directory
.Trash-*

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log
logs/

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/

# Dependency directories
node_modules/
jspm_packages/

# Optional npm cache directory
.npm

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env

# Backup files
*.bak
*.backup
*.old

# Temporary files
*.tmp
*.temp 